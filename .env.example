# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# 사이트 주소 (로컬: http://localhost:3000 / 배포: https://www.melodybug.co.kr)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 페이지에 접근 가능한 이메일 (여러 개면 쉼표로 구분)
ADMIN_EMAILS=you@example.com

# KG이니시스
# 개발/테스트: 아래 테스트 값 그대로 사용 (실제 결제 안 됨)
# 운영: 실제 가맹점 MID / 웹결제 signKey 로 바꾸고 INICIS_TEST=false
INICIS_MID=INIpayTest
INICIS_SIGN_KEY=SU5JTElURV9UUklQTEVERVNfS0VZU1RS
INICIS_TEST=true

# 구글 서치콘솔 HTML 태그 인증 코드 (content="..." 안의 값만)
GOOGLE_SITE_VERIFICATION=

# 결제 테스트용 1,000원 상품 (/order?plan=test). 오픈 전 반드시 false
ENABLE_TEST_PLAN=false
